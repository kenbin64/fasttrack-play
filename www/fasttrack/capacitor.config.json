{
  "appId": "com.butterflyfx.fasttrack",
  "appName": "FastTrack",
  "webDir": "..",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#000812",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#000812"
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#000812"
  },
  "android": {
    "backgroundColor": "#000812",
    "allowMixedContent": true
  }
}
